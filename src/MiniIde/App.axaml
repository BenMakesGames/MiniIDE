<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MiniIde.App"
             xmlns:local="using:MiniIde"
             RequestedThemeVariant="Dark">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <FontFamily x:Key="IconFont">avares://MiniIde/Assets/icons/MaterialDesignIconsDesktop.ttf#Material Design Icons Desktop</FontFamily>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>
        <!-- Always underline access-key letters (e.g. the "_O" in "_Open solution..."). By default Avalonia only
             shows them while Alt is held, which nobody does with mouse-driven context menus. Applies app-wide,
             so new menus get it for free. -->
        <Style Selector="AccessText">
            <Setter Property="ShowAccessKey" Value="True"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="16"/>
        </Style>
    </Application.Styles>
</Application>