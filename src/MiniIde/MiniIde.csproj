<?xml version="1.0" encoding="utf-8"?><Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- R2R was OFF because crossgen couldn't resolve the MSBuild assemblies MSBuildLocator loaded from the SDK
         (NETSDK1096). MiniIDE no longer loads MSBuild, so that reason is gone; turning it on is untried. -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <!-- Version = build time in UTC: year . day of year (1-366) . minute of day (0-1439). Every part fits the
       65535 cap on assembly-version components. The clock is read ONCE into _BuildTicks and every part derived
       from that, so a build straddling midnight can't pair one day's year/day with the next day's minute. -->
  <PropertyGroup>
    <_BuildTicks>$([System.DateTime]::UtcNow.Ticks)</_BuildTicks>
    <Version>$([System.DateTime]::FromBinary($(_BuildTicks)).Year).$([System.DateTime]::FromBinary($(_BuildTicks)).DayOfYear).$([MSBuild]::Add($([MSBuild]::Multiply($([System.DateTime]::FromBinary($(_BuildTicks)).Hour), 60)), $([System.DateTime]::FromBinary($(_BuildTicks)).Minute)))</Version>
  </PropertyGroup>

  <Target Name="RemoveNativePdbs" AfterTargets="Publish">
    <ItemGroup>
      <_PdbToDelete Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PdbToDelete)" />
  </Target>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
    <PackageReference Include="NuGet.Protocol" Version="7.9.0" />
    <!-- Pin transitive to patched version. NuGet.Packaging 7.6.0 pulls 9.0.0 which has GHSA-37gx-xxp4-5rgx / GHSA-w3x6-4m5h-cxqf. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>
</Project>
